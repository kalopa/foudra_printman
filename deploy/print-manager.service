#
# systemd unit for the Pi. Install to /etc/systemd/system/, then:
#   systemctl daemon-reload && systemctl enable --now print-manager
# Keys live in /etc/print-manager/env (root:root 0600), never here.
#
[Unit]
Description=Foudra Print Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=print-manager
EnvironmentFile=/etc/print-manager/env
ExecStart=/usr/local/bin/print-manager serve
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/print-manager

[Install]
WantedBy=multi-user.target
